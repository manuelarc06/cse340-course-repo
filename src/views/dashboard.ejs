<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <h2>User Information</h2>

        <p>Name: <%= user.name %>
        </p>
        <p>Email: <%= user.email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>

            <p>
                <a href="/users">
                    View All Users
                </a>
            </p>

            <% } %>

    </main>

    <%- include('partials/footer') %>