<%- include('partials/header') %>

    <main>

        <h1>
            <%= title %>
        </h1>

        <h2>User Information</h2>

        <p>Name: <%= user.name %>
        </p>
        <p>Email: <%= user.email %>
        </p>

        <h2>
            Volunteer Projects
        </h2>
        
        <% if (volunteerProjects.length===0) { %>
        
            <p>
                You have not volunteered for any projects.
            </p>
        
            <% } else { %>
        
                <ul>
        
                    <% volunteerProjects.forEach(project=> { %>
        
                        <li>
        
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
        
                            -
                            <a href="/project/<%= project.project_id %>/unvolunteer">
                                Remove
                            </a>
        
                        </li>
        
                        <% }) %>
        
                </ul>
        
                <% } %>

        <% if (user && user.role_name==='admin' ) { %>

            <p>
                <a href="/users">
                    View All Users
                </a>
            </p>

            <% } %>

    </main>

    <%- include('partials/footer') %>